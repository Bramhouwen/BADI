# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Public URL of the app (used for magic links and invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the service-role key in NEXT_PUBLIC_* variables.
# The app does not need it: all writes go through RLS and SECURITY DEFINER functions.

# Demo-modus (optioneel): 1 = in-memory voorbeelddata zonder Supabase, alleen voor lokaal bekijken.
NEXT_PUBLIC_WINTER_ARC_DEMO=0

# Baddy de Coach (server only, never NEXT_PUBLIC_). Without it the coach shows a 'not connected' state.
ANTHROPIC_API_KEY=
